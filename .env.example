# Supabase Project Configuration
# Replace these placeholder values with your real project credentials from the Supabase Dashboard:
# Project Settings -> API -> Project URL & Project API Keys (anon / public)

# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Public / Anon API Key (Safe for browser / frontend usage)
# DO NOT USE SERVICE-ROLE KEY HERE
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here

